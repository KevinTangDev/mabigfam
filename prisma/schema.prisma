generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./mabigfam.db"
}

model FamilyMember {
  id        String    @id @default(uuid())
  name      String
  nameZh    String?
  birthday  DateTime?
  phone     String?
  address   String?
  note      String?
  photoPath String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Rows where this member is the parent
  childLinks  ParentChild[] @relation("ParentRelation")
  // Rows where this member is the child
  parentLinks ParentChild[] @relation("ChildRelation")

  @@map("family_members")
}

model ParentChild {
  id       String @id @default(uuid())
  parentId String
  childId  String

  parent FamilyMember @relation("ParentRelation", fields: [parentId], references: [id], onDelete: Cascade)
  child  FamilyMember @relation("ChildRelation", fields: [childId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([parentId, childId])
  @@map("parent_child")
}

/// Family reunions and other important dates. Birthdays are not stored here —
/// they're derived from FamilyMember.birthday when building the calendar feed.
model FamilyEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  /// Null means a single-day (or single-instant) event.
  endsAt      DateTime?
  /// All-day events are emitted as DATE values in the .ics feed, so they
  /// don't shift around for family in other timezones.
  allDay      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startsAt])
  @@map("family_events")
}
