# Settings for the Docker Compose deployment. Copy to .env in the repo root:
#
#   cp deploy/docker.env.example .env
#
# .env is git-ignored and holds secrets — never commit it, and never paste its
# contents into a chat or an issue.

# The passphrase your whole family signs in with. The app is reachable from
# the internet, so make it long: four or five random words is plenty.
FAMILY_PASSWORD=

# Signs the session cookie. At least 32 characters; generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# The address people use to reach the app, e.g. https://family.example.com
WEB_ORIGIN=https://family.example.com

# --- Public access through Cloudflare Tunnel -------------------------------
# Token from Cloudflare Zero Trust → Networks → Tunnels → your tunnel. Setting
# COMPOSE_PROFILES=tunnel makes `docker compose up` start the tunnel as well.
# For LAN-only use, delete both lines.
COMPOSE_PROFILES=tunnel
TUNNEL_TOKEN=

# --- Optional --------------------------------------------------------------
# Defaults to true, which is right when only the tunnel can reach the app (the
# supplied compose.yaml publishes no port). Use false if you publish the port.
# TRUST_PROXY=true

# Only for a plain-HTTP, LAN-only deployment: lets the session cookie work
# without HTTPS. Leave unset when using the tunnel.
# COOKIE_SECURE=false

# Rotate the calendar feed URL (invalidating existing subscriptions) without
# signing anyone out. Derived from SESSION_SECRET when unset.
# CALENDAR_FEED_TOKEN=
