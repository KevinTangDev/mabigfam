# Copy to server/.env and fill in. The server refuses to start without the
# two secrets below, so it can never accidentally run unauthenticated.

# Shared passphrase your family uses to sign in (minimum 8 characters).
FAMILY_PASSWORD=change-me-to-something-your-family-can-remember

# Key used to sign the session cookie (minimum 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional
# PORT=3001
# WEB_ORIGIN=http://localhost:5173
# UPLOAD_DIR=./uploads
# MAX_PHOTO_BYTES=8388608
# WEB_DIST_DIR=../web/dist

# Every accepted photo is resized to fit within this many pixels on its
# longest side and re-encoded as JPEG at this quality (0-100) before being
# stored. Nothing in the app displays a photo anywhere near 2000px, so the
# default is generous headroom rather than a tight fit.
# PHOTO_MAX_DIMENSION=2000
# PHOTO_QUALITY=82

# Set to production once deployed. Among other things this requires HTTPS
# for the session cookie to work at all (see COOKIE_SECURE below) — do this
# before setting NODE_ENV=production, not after, or login will silently
# appear to succeed and then not actually keep you signed in.
# NODE_ENV=production

# Only needed if you deliberately run production over plain HTTP (e.g. a
# home-LAN-only server with no TLS). Without HTTPS, NODE_ENV=production's
# default cookie behavior means login looks like it works but the session
# is never actually stored by the browser once you're reached by LAN IP or
# hostname rather than "localhost" specifically. Uncomment only if you
# understand the trade-off: the session cookie then travels in cleartext.
# COOKIE_SECURE=false

# Secret token embedded in the calendar feed URL. Derived from SESSION_SECRET
# when unset; set it explicitly to rotate the feed (invalidating existing
# calendar subscriptions) without signing everyone out.
# CALENDAR_FEED_TOKEN=
