# Copy to server/.env and fill in. The server refuses to start without the
# two secrets below, so it can never accidentally run unauthenticated.

# Shared passphrase your family uses to sign in (minimum 8 characters).
FAMILY_PASSWORD=change-me-to-something-your-family-can-remember

# Key used to sign the session cookie (minimum 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional
# PORT=3001
# WEB_ORIGIN=http://localhost:5173
# UPLOAD_DIR=./uploads
# MAX_PHOTO_BYTES=8388608
