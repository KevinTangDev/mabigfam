{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --schema=../prisma/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "10.0.2",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "10.1.3",
    "@prisma/client": "6.19.3",
    "archiver": "^8.0.0",
    "fastify": "5.12.4",
    "sharp": "0.35.4",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^8.0.0",
    "@types/node": "22.10.5",
    "adm-zip": "^0.6.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prisma": "6.19.3",
    "tsx": "4.23.13",
    "typescript": "5.7.3",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.7"
  }
}
